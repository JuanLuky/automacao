{
  "name": "Atendimento WhatsApp - Menu de Departamentos",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook - Evolution API",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "id": "node-webhook",
      "webhookId": "atendimento-whatsapp-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Pega o corpo enviado pela Evolution API\nconst body = $input.item.json.body ?? $input.item.json;\nconst event = body.event;\nconst data = body.data;\n\n// Ignora tudo que não for mensagem recebida (ex: connection.update, qrcode.updated)\nif (event !== 'messages.upsert') {\n  return [];\n}\n\nif (!data || !data.key) {\n  return [];\n}\n\n// Ignora mensagens que a própria instância enviou (eco)\nif (data.key.fromMe) {\n  return [];\n}\n\nconst remoteJid = data.key.remoteJid || '';\nconst telefone = remoteJid.split('@')[0];\nconst nome = data.pushName || 'Cliente';\n\nconst texto =\n  data.message?.conversation ||\n  data.message?.extendedTextMessage?.text ||\n  '';\n\nreturn [\n  {\n    json: {\n      telefone,\n      nome,\n      texto: texto.trim(),\n      instance: body.instance,\n    },\n  },\n];\n"
      },
      "name": "Extrair Dados da Mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300],
      "id": "node-extract"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-digito",
              "leftValue": "={{ $json.texto }}",
              "rightValue": "^[1-5]$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Escolheu Departamento? (1-5)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [640, 300],
      "id": "node-if-escolha"
    },
    {
      "parameters": {
        "jsCode": "const opcao = $json.texto;\n\nconst departamentos = {\n  '1': 'RH',\n  '2': 'Financeiro',\n  '3': 'Contabilidade',\n  '4': 'TI',\n  '5': 'Comercial',\n};\n\nconst nomeDepartamento = departamentos[opcao];\n\nreturn [\n  {\n    json: {\n      telefone: $json.telefone,\n      nome: $json.nome,\n      instance: $json.instance,\n      departamento: nomeDepartamento,\n      resposta: `Perfeito! Você foi direcionado para o setor de *${nomeDepartamento}*. Em instantes um atendente vai continuar seu atendimento por aqui. 🙂`,\n    },\n  },\n];\n"
      },
      "name": "Mapear Departamento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 200],
      "id": "node-map-department"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ \"http://evolution-api:8080/message/sendText/\" + $json.instance }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "COLOQUE_AQUI_A_EVOLUTION_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"number\": $json.telefone, \"text\": $json.resposta } }}",
        "options": {}
      },
      "name": "Enviar Confirmação de Setor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 200],
      "id": "node-send-confirmation"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ \"http://evolution-api:8080/message/sendText/\" + $json.instance }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "COLOQUE_AQUI_A_EVOLUTION_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"number\": $json.telefone, \"text\": \"Olá! Seja bem-vindo(a) 👋\\n\\nEscolha o departamento que você deseja falar:\\n\\n1 - RH\\n2 - Financeiro\\n3 - Contabilidade\\n4 - TI\\n5 - Comercial\\n\\nDigite o número da opção desejada.\" } }}",
        "options": {}
      },
      "name": "Enviar Menu",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 420],
      "id": "node-send-menu"
    }
  ],
  "connections": {
    "Webhook - Evolution API": {
      "main": [
        [
          {
            "node": "Extrair Dados da Mensagem",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extrair Dados da Mensagem": {
      "main": [
        [
          {
            "node": "Escolheu Departamento? (1-5)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Escolheu Departamento? (1-5)": {
      "main": [
        [
          {
            "node": "Mapear Departamento",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Enviar Menu",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mapear Departamento": {
      "main": [
        [
          {
            "node": "Enviar Confirmação de Setor",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
