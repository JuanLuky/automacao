{
  "name": "Atendimento WhatsApp - Fluxo Completo (com Backend)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook - Evolution API",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 400],
      "id": "node-webhook",
      "webhookId": "atendimento-whatsapp-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body ?? $input.item.json;\nconst event = body.event;\nconst data = body.data;\n\nif (event !== 'messages.upsert') {\n  return [];\n}\nif (!data || !data.key) {\n  return [];\n}\n\n// fromMe = mensagem enviada por nós (WhatsApp conectado), não recebida de\n// alguém. Antes essas mensagens eram descartadas aqui (o único jeito de\n// mandar mensagem era pelo painel, que já registra sozinho); agora também\n// tratamos esse evento como \"mensagem mandada direto do celular, fora do\n// painel\" — ver \"É Mensagem Minha Sem Conversa Existente?\" e Registrar\n// Mensagem mais adiante.\nconst ehFromMe = !!data.key.fromMe;\n\nconst remoteJid = data.key.remoteJid || '';\n// Grupo do WhatsApp tem remoteJid terminando em \"@g.us\" (contato\n// individual termina em \"@s.whatsapp.net\"). Em grupo, \"telefone\" guarda o\n// JID inteiro (não só os dígitos) — é o identificador usado tanto pra\n// achar/criar a conversa (GET .../by-phone) quanto pro campo \"number\" ao\n// responder via Evolution API, que exige o JID completo pra mandar\n// mensagem num grupo (não existe \"número\" de grupo). O nome do grupo não\n// é buscado aqui (exigiria uma chamada extra à Evolution API) — aparece\n// como \"Grupo sem nome\" no painel.\nconst ehGrupo = remoteJid.endsWith('@g.us');\nconst telefone = ehGrupo ? remoteJid : remoteJid.split('@')[0];\nconst nome = ehGrupo ? null : (data.pushName || 'Cliente');\n\n// Quem escreveu de fato dentro do grupo — só existe pra mensagem de um\n// participante (nunca pra fromMe, que somos nós mesmos). \"participant\" é\n// o JID do membro do grupo que mandou; pushName é o nome de exibição dele\n// no WhatsApp. Numa conversa 1:1 isso não é necessário (o remetente já é\n// o telefone/nome da própria conversa) — ver \"Grupos do WhatsApp\" no\n// CLAUDE.md.\nconst participanteJid = ehGrupo && !ehFromMe ? (data.key.participant || '') : '';\nconst remetenteTelefone = participanteJid ? participanteJid.split('@')[0] : null;\nconst remetenteNome = ehGrupo && !ehFromMe ? (data.pushName || null) : null;\n\n// Tipo de mídia detectado pela presença do campo correspondente em\n// data.message — o texto/legenda de cada tipo vem de onde a Evolution\n// API já coloca (conversation/extendedTextMessage para texto puro,\n// caption para imagem/vídeo/documento). O conteúdo do arquivo em si\n// (base64) só é buscado depois, via node \"Buscar Mídia\", usando\n// wa_message_id.\nconst msg = data.message || {};\nlet tipo = 'texto';\nlet texto = msg.conversation || msg.extendedTextMessage?.text || '';\n\nif (msg.imageMessage) {\n  tipo = 'imagem';\n  texto = msg.imageMessage.caption || '';\n} else if (msg.audioMessage) {\n  tipo = 'audio';\n  texto = '';\n} else if (msg.documentMessage) {\n  tipo = 'documento';\n  texto = msg.documentMessage.caption || '';\n} else if (msg.videoMessage) {\n  tipo = 'video';\n  texto = msg.videoMessage.caption || '';\n}\n\nreturn [\n  {\n    json: {\n      telefone,\n      nome,\n      texto: texto.trim(),\n      instance: body.instance,\n      tipo,\n      // Id da mensagem no WhatsApp — usado tanto pra baixar mídia (Buscar\n      // Mídia) quanto pra dedup de mensagem fromMe (Registrar Mensagem).\n      wa_message_id: data.key.id || null,\n      eh_grupo: ehGrupo,\n      eh_from_me: ehFromMe,\n      remetente_nome: remetenteNome,\n      remetente_telefone: remetenteTelefone,\n    },\n  },\n];\n"
      },
      "name": "Extrair Dados da Mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 400],
      "id": "node-extract"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ \"http://host.docker.internal:3000/conversations/by-phone/\" + $json.telefone }}",
        "options": {}
      },
      "name": "Verificar Conversa Ativa",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueErrorOutput",
      "position": [620, 400],
      "id": "node-check-conversation"
    },
    {
      "parameters": {
        "jsCode": "const original = $('Extrair Dados da Mensagem').item.json;\nconst conversa = $input.item.json;\n\n// eh_from_me = mensagem mandada direto do celular conectado, fora do\n// painel — registra como origem \"atendente\", origem_externa: true (o\n// backend só guarda no histórico, não reenvia ao WhatsApp nem exige\n// atendente/instance — ver MessagesService.create). Senão é mensagem\n// normal de cliente/participante do grupo.\nconst json = {\n  conversation_id: conversa.id,\n  mensagem: original.texto,\n  origem: original.eh_from_me ? 'atendente' : 'cliente',\n};\n\nif (original.eh_from_me) {\n  json.origem_externa = true;\n  json.evolution_message_id = original.wa_message_id;\n} else if (original.eh_grupo) {\n  // Quem escreveu dentro do grupo (ver \"Grupos do WhatsApp\" no CLAUDE.md)\n  // — não existe pra conversa 1:1, onde o remetente já é a própria conversa.\n  json.remetente_nome = original.remetente_nome;\n  json.remetente_telefone = original.remetente_telefone;\n}\n\nreturn [{ json }];\n"
      },
      "name": "Preparar Mensagem do Cliente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 300],
      "id": "node-prepare-message"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-tipo-midia",
              "leftValue": "={{ $('Extrair Dados da Mensagem').item.json.tipo }}",
              "rightValue": "texto",
              "operator": { "type": "string", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "É Mensagem de Mídia?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [860, 220],
      "id": "node-if-midia"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ \"http://evolution-api:8080/chat/getBase64FromMediaMessage/\" + $('Extrair Dados da Mensagem').item.json.instance }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "COLOQUE_AQUI_A_EVOLUTION_API_KEY" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"message\": { \"key\": { \"id\": $('Extrair Dados da Mensagem').item.json.wa_message_id } } } }}",
        "options": {}
      },
      "name": "Buscar Mídia",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 100],
      "id": "node-fetch-media"
    },
    {
      "parameters": {
        "jsCode": "const original = $('Extrair Dados da Mensagem').item.json;\nconst conversa = $('Definir Conversa Atual').item.json;\nconst resultado = $json; // resposta de \"Buscar Mídia\": mediaType, fileName, size, mimetype, base64\n\n// Mesmo critério de \"Preparar Mensagem do Cliente\" — ver comentário lá.\nconst json = {\n  conversation_id: conversa.id,\n  mensagem: original.texto,\n  tipo: original.tipo,\n  midia_base64: resultado.base64,\n  midia_mimetype: resultado.mimetype,\n  midia_nome_arquivo: resultado.fileName || null,\n  origem: original.eh_from_me ? 'atendente' : 'cliente',\n};\n\nif (original.eh_from_me) {\n  json.origem_externa = true;\n  json.evolution_message_id = original.wa_message_id;\n} else if (original.eh_grupo) {\n  json.remetente_nome = original.remetente_nome;\n  json.remetente_telefone = original.remetente_telefone;\n}\n\nreturn [{ json }];\n"
      },
      "name": "Montar Mensagem de Mídia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 100],
      "id": "node-build-media-message"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ \"http://host.docker.internal:3000/conversations/\" + $json.conversation_id + \"/messages\" }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"origem\": $json.origem, \"mensagem\": $json.mensagem, \"tipo\": $json.tipo, \"midia_base64\": $json.midia_base64, \"midia_mimetype\": $json.midia_mimetype, \"midia_nome_arquivo\": $json.midia_nome_arquivo, \"origem_externa\": $json.origem_externa, \"evolution_message_id\": $json.evolution_message_id, \"remetente_nome\": $json.remetente_nome, \"remetente_telefone\": $json.remetente_telefone } }}",
        "options": {}
      },
      "name": "Registrar Mensagem do Cliente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1520, 200],
      "id": "node-register-message"
    },

    {
      "parameters": {
        "jsCode": "// Ponto único de referência pra \"qual é a conversa atual\" — alimentado\n// tanto por \"Verificar Conversa Ativa\" (conversa já existia, cliente ou\n// grupo) quanto por \"Criar Conversa de Grupo\" (grupo novo, primeira\n// mensagem). \"Montar Mensagem de Mídia\" referencia só este node, sem\n// precisar saber qual dos dois caminhos gerou o item.\nreturn [{ json: $json }];\n"
      },
      "name": "Definir Conversa Atual",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 300],
      "id": "node-define-current-conversation"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-fromme-sem-conversa",
              "leftValue": "={{ $('Extrair Dados da Mensagem').item.json.eh_from_me }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "É Mensagem Minha Sem Conversa Existente?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [780, 780],
      "id": "node-if-fromme-sem-conversa"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-eh-grupo",
              "leftValue": "={{ $('Extrair Dados da Mensagem').item.json.eh_grupo }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "É Mensagem de Grupo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [860, 780],
      "id": "node-if-grupo"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/conversations",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"telefone\": $('Extrair Dados da Mensagem').item.json.telefone, \"tipo\": \"grupo\" } }}",
        "options": {}
      },
      "name": "Criar Conversa de Grupo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 780],
      "id": "node-create-group-conversation"
    },

    {
      "parameters": {
        "operation": "get",
        "propertyName": "bufferAtual",
        "key": "=buffer:{{ $('Extrair Dados da Mensagem').item.json.telefone }}",
        "options": {}
      },
      "name": "Redis - Buscar Buffer Atual",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [860, 560],
      "id": "node-debounce-get-buffer"
    },
    {
      "parameters": {
        "jsCode": "// Sem debounce nativo no n8n: acumulamos as mensagens fragmentadas de um\n// mesmo telefone num buffer no Redis, e só respondemos depois que ninguém\n// mandou nada novo por alguns segundos (ver node \"Wait - Aguardar Fragmentos\").\nconst original = $('Extrair Dados da Mensagem').item.json;\nconst bufferAtual = $json.bufferAtual || '';\nconst novoTexto = original.texto || '';\nconst novoBuffer = bufferAtual ? `${bufferAtual}\\n${novoTexto}` : novoTexto;\n\nreturn [\n  {\n    json: {\n      telefone: original.telefone,\n      novoBuffer,\n    },\n  },\n];\n"
      },
      "name": "Code - Acrescentar ao Buffer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 560],
      "id": "node-debounce-append"
    },
    {
      "parameters": {
        "operation": "set",
        "key": "=buffer:{{ $('Extrair Dados da Mensagem').item.json.telefone }}",
        "value": "={{ $json.novoBuffer }}",
        "expire": true,
        "ttl": 30,
        "options": {}
      },
      "name": "Redis - Salvar Buffer",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [1300, 560],
      "id": "node-debounce-set-buffer"
    },
    {
      "parameters": {
        "operation": "set",
        "key": "=latest:{{ $('Extrair Dados da Mensagem').item.json.telefone }}",
        "value": "={{ $execution.id }}",
        "expire": true,
        "ttl": 30,
        "options": {}
      },
      "name": "Redis - Marcar Última Mensagem",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [1520, 560],
      "id": "node-debounce-set-latest"
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "amount": 6,
        "unit": "seconds"
      },
      "name": "Wait - Aguardar Fragmentos",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1740, 560],
      "id": "node-debounce-wait",
      "webhookId": "atendimento-whatsapp-wait-debounce"
    },
    {
      "parameters": {
        "operation": "get",
        "propertyName": "latestExecId",
        "key": "=latest:{{ $('Extrair Dados da Mensagem').item.json.telefone }}",
        "options": {}
      },
      "name": "Redis - Conferir Última Mensagem",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [1960, 560],
      "id": "node-debounce-get-latest"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-latest-match",
              "leftValue": "={{ $json.latestExecId }}",
              "rightValue": "={{ $execution.id }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "IF - É a Última do Burst?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2180, 560],
      "id": "node-debounce-if-last"
    },
    {
      "parameters": {
        "operation": "get",
        "propertyName": "textoCombinado",
        "key": "=buffer:{{ $('Extrair Dados da Mensagem').item.json.telefone }}",
        "options": {}
      },
      "name": "Redis - Buscar Buffer Final",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [2400, 480],
      "id": "node-debounce-get-final-buffer"
    },
    {
      "parameters": {
        "jsCode": "// Última execução da rajada: junta o texto combinado no mesmo formato\n// de saída do node \"Extrair Dados da Mensagem\", pra tudo que vem depois\n// (checagem de departamento, menu, etc.) funcionar sem saber que existiu\n// um debounce no meio do caminho.\nconst original = $('Extrair Dados da Mensagem').item.json;\nconst textoCombinado = ($json.textoCombinado || original.texto || '').trim();\n\nreturn [\n  {\n    json: {\n      telefone: original.telefone,\n      nome: original.nome,\n      instance: original.instance,\n      texto: textoCombinado,\n    },\n  },\n];\n"
      },
      "name": "Combinar Fragmentos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2620, 480],
      "id": "node-debounce-combine"
    },
    {
      "parameters": {
        "operation": "delete",
        "key": "=buffer:{{ $('Extrair Dados da Mensagem').item.json.telefone }}"
      },
      "name": "Redis - Limpar Buffer",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [2840, 480],
      "id": "node-debounce-clear-buffer"
    },

    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:3000/business-hours",
        "options": {}
      },
      "name": "Consultar Horário de Funcionamento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2840, 700],
      "id": "node-business-hours-check"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-dentro-horario",
              "leftValue": "={{ $json.aberto }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Dentro do Horário de Funcionamento?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [3060, 700],
      "id": "node-if-business-hours"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ \"http://evolution-api:8080/message/sendText/\" + $('Combinar Fragmentos').item.json.instance }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "COLOQUE_AQUI_A_EVOLUTION_API_KEY" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"number\": $('Combinar Fragmentos').item.json.telefone, \"text\": $('Consultar Horário de Funcionamento').item.json.mensagem_fora_horario } }}",
        "options": {}
      },
      "name": "Enviar Mensagem - Fora do Horário",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3280, 860],
      "id": "node-send-outside-hours"
    },

    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:3000/departments",
        "options": {}
      },
      "name": "Buscar Departamentos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3060, 480],
      "id": "node-fetch-departments"
    },
    {
      "parameters": {
        "jsCode": "const original = $('Combinar Fragmentos').item.json;\n\n// GET /departments já vem ordenado por nome (ver DepartmentsService.findAll) —\n// a numeração do menu segue essa mesma ordem, dinamicamente, sem mapeamento fixo.\n// O node HTTP Request separa cada elemento do array retornado pela API\n// em um item diferente — por isso reconstruímos o array com .all()\n// em vez de usar $input.item.json (que seria só 1 departamento).\nconst departamentos = $('Buscar Departamentos').all().map((item) => item.json);\n\nconst numero = Number(original.texto);\nconst valido = Number.isInteger(numero) && numero >= 1 && numero <= departamentos.length;\nconst departamento = valido ? departamentos[numero - 1] : null;\n\nreturn [\n  {\n    json: {\n      telefone: original.telefone,\n      nome: original.nome,\n      instance: original.instance,\n      texto: original.texto,\n      departamentos,\n      opcaoValida: valido,\n      departamento_id: departamento ? departamento.id : null,\n      departamento_nome: departamento ? departamento.nome : null,\n    },\n  },\n];\n"
      },
      "name": "Avaliar Escolha de Departamento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3280, 480],
      "id": "node-map-department"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-opcao-valida",
              "leftValue": "={{ $json.opcaoValida }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Escolheu Departamento Válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [3500, 480],
      "id": "node-if-escolha"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/conversations",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"telefone\": $json.telefone, \"cliente_nome\": $json.nome, \"departamento_id\": $json.departamento_id, \"mensagem_inicial\": $json.texto } }}",
        "options": {}
      },
      "name": "Criar Conversa",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3720, 400],
      "id": "node-create-conversation"
    },
    {
      "parameters": {
        "jsCode": "const mapeado = $('Avaliar Escolha de Departamento').item.json;\n\nreturn [\n  {\n    json: {\n      telefone: mapeado.telefone,\n      instance: mapeado.instance,\n      resposta: `Perfeito! Você foi direcionado para o setor de *${mapeado.departamento_nome}*. Em instantes um atendente vai continuar seu atendimento por aqui. 🙂`,\n    },\n  },\n];\n"
      },
      "name": "Montar Confirmação",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3940, 400],
      "id": "node-build-confirmation"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ \"http://evolution-api:8080/message/sendText/\" + $json.instance }}",
