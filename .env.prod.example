# Modelo do .env de PRODUÇÃO (docker-compose.prod.yml).
# Na VPS: cp .env.prod.example .env  → preencher tudo → nunca commitar o .env.
# Gerar segredos com: openssl rand -hex 32

# ── Domínios (registros DNS tipo A apontando pro IP da VPS) ──
DOMINIO_PAINEL=painel.exemplo.com.br
DOMINIO_API=api.exemplo.com.br
ACME_EMAIL=voce@exemplo.com.br        # avisos do Let's Encrypt (expiração de certificado)

# ── Postgres ──
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=                    # openssl rand -hex 32

# ── Evolution API ──
EVOLUTION_API_KEY=                    # openssl rand -hex 32 — idêntica na credencial HTTP do n8n
EVOLUTION_SERVER_URL=http://localhost:8089

# ── n8n (login do editor) ──
N8N_USER=admin
N8N_PASSWORD=                         # senha forte

# ── Backend ──
JWT_SECRET=                           # openssl rand -hex 32
JWT_EXPIRES_IN=7d
N8N_API_KEY=                          # openssl rand -hex 32 — idêntica no header x-n8n-api-key dos nós do n8n

# ── Frontend ──
NEXT_PUBLIC_EVOLUTION_INSTANCE=atendimento-empresa   # nome da instância criada na Evolution API

# ── Backup (scripts/backup.sh) ──
# Destino remoto no formato do rclone (ex: "b2:mare-backups/cliente-x").
# Vazio = só guarda na própria VPS (NÃO protege contra perda do disco).
BACKUP_REMOTO=
BACKUP_DIAS_RETENCAO=7
